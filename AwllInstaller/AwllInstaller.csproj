<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>AwllInstaller</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>Awll-Disk-Utility-Setup</AssemblyName>
    <ApplicationTitle>Installation d'Awll Disk Utility</ApplicationTitle>
    <Product>Awll Disk Utility</Product>
    <Company>Benawll</Company>
    <Authors>Benawll</Authors>
    <ApplicationIcon>..\Awll\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Resource Include="..\Awll\app.ico" Link="app.ico" />
    <EmbeddedResource Include="Payload\Awll-Disk-Utility.exe.gz" LogicalName="AwllInstaller.Payload.Awll-Disk-Utility.exe.gz" Condition="Exists('Payload\Awll-Disk-Utility.exe.gz')" />
  </ItemGroup>

</Project>
