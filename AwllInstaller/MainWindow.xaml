<Window x:Class="AwllInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation d'Awll"
        Icon="app.ico"
        Width="520"
        Height="490"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0EEE7"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="SwissSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#ECEAE2"/>
            <Setter Property="Foreground" Value="#181816"/>
            <Setter Property="BorderBrush" Value="#24181816"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2DFD5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwissPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#B84B2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C45331"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwissDangerOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#14C5302C"/>
            <Setter Property="Foreground" Value="#C5302C"/>
            <Setter Property="BorderBrush" Value="#C5302C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24C5302C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER ATELIER SUISSE -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Geometric A Monogram Tile -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#B84B2A" Margin="0,0,14,0">
                <Canvas Width="44" Height="44">
                    <Path Stroke="#FAF9F5" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 13,31 L 22,12 L 31,31"/>
                    <Line X1="15.8" Y1="25.5" X2="28.2" Y2="25.5" Stroke="#FAF9F5" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Awll" FontSize="20" FontWeight="Bold" Foreground="#181816" Margin="0,-2,0,0"/>
                <TextBlock x:Name="TxtSubtitle" Text="Disk Utility — v5.0.0" FontSize="12" FontFamily="Consolas, Segoe UI" Foreground="#66635A"/>
            </StackPanel>

            <!-- Install vs Upgrade Badge -->
            <Border x:Name="BadgeBorder" Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="10,5" Background="#192D6A4F" BorderBrush="#2D6A4F" BorderThickness="1">
                <TextBlock x:Name="TxtStatusBadge" Text="Nouvelle installation" FontSize="11" FontWeight="SemiBold" Foreground="#2D6A4F"/>
            </Border>
        </Grid>

        <!-- MAIN CARD (#FAF9F5) -->
        <Border Grid.Row="1" Background="#FAF9F5" BorderBrush="#1A181816" BorderThickness="1" CornerRadius="14" Padding="20">
            <Grid>
                <!-- PANEL 1: READY / OPTIONS -->
                <StackPanel x:Name="PanelReady" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReadyDesc" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="#181816" Margin="0,0,0,14"
                               Text="Installe Awll dans votre espace utilisateur Windows, sans droits administrateur ni configuration complexe."/>

                    <TextBlock Text="Emplacement cible" FontSize="11" FontWeight="SemiBold" Foreground="#66635A" Margin="0,0,0,6"/>
                    <Border Background="#ECEAE2" BorderBrush="#1A181816" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtInstallPath" Text="%LocalAppData%\Programs\Awll" FontFamily="Consolas" FontSize="11.5" Foreground="#181816" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <CheckBox x:Name="ChkStartMenu" IsChecked="True" Margin="0,0,0,8" Content="Créer un raccourci dans le Menu Démarrer"/>
                    <CheckBox x:Name="ChkDesktop" IsChecked="True" Content="Créer un raccourci sur le Bureau"/>

                    <StackPanel x:Name="PanelUninstallOption" Visibility="Collapsed" Margin="0,12,0,0">
                        <CheckBox x:Name="ChkRemoveUserData" IsChecked="False" Foreground="#66635A"
                                  Content="Lors de la désinstallation, supprimer aussi mes réglages (%LocalAppData%\Awll)"/>
                    </StackPanel>

                    <Border x:Name="ErrorBox" Visibility="Collapsed" Margin="0,12,0,0" Background="#14C5302C" BorderBrush="#C5302C" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <TextBlock x:Name="TxtError" TextWrapping="Wrap" FontSize="11.5" Foreground="#C5302C"/>
                    </Border>
                </StackPanel>

                <!-- PANEL 2: INSTALLING PROGRESS -->
                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtProgressStep" Grid.Column="0" Text="Préparation..." FontSize="12.5" FontWeight="SemiBold" Foreground="#181816"/>
                        <TextBlock x:Name="TxtProgressPct" Grid.Column="1" Text="0%" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#B84B2A"/>
                    </Grid>

                    <Border Height="8" CornerRadius="4" Background="#E7E4DC" ClipToBounds="True" Margin="0,0,0,12">
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Height="8" CornerRadius="4" Background="#B84B2A"/>
                    </Border>

                    <TextBlock x:Name="TxtProgressNote" Text="Si une ancienne version était ouverte, elle est fermée et remplacée proprement. Vos paramètres IA et votre liste protégée restent intacts."
                               TextWrapping="Wrap" FontSize="11.5" Foreground="#66635A" LineHeight="17"/>
                </StackPanel>

                <!-- PANEL 3: COMPLETE -->
                <StackPanel x:Name="PanelComplete" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#2D6A4F" Margin="0,0,10,0">
                            <Canvas Width="28" Height="28">
                                <Path Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 8,14.5 L 12,18.5 L 20,10"/>
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="TxtCompleteTitle" Text="Awll v5.0.0 est installé" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#181816"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtCompleteDesc" Text="L'application est prête et enregistrée dans Paramètres Windows → Applications pour une désinstallation propre à tout moment."
                               TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#66635A" Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkLaunchNow" IsChecked="True" Content="Lancer Awll maintenant"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Benawll • Awll" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#66635A"/>
            <Button x:Name="BtnUninstall" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource SwissDangerOutlineButton}" Content="Désinstaller" Click="BtnUninstall_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel" Grid.Column="2" Style="{StaticResource SwissSecondaryButton}" Content="Annuler" Click="BtnCancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnAction" Grid.Column="3" Style="{StaticResource SwissPrimaryButton}" Content="Installer Awll" Click="BtnAction_Click"/>
        </Grid>
    </Grid>
</Window>
